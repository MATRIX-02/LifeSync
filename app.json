{
	"expo": {
		"name": "LifeSync",
		"slug": "lifesync",
		"version": "2.1.0",
		"orientation": "default",
		"icon": "./assets/images/icon.png",
		"scheme": "lifesync",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/images/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#060F2B"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.matrix122001.HabitTrackerApp",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"android": {
			"intentFilters": [
				{
					"action": "VIEW",
					"data": [
						{
							"scheme": "lifesync"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			],
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"monochromeImage": "./assets/images/monochrome-icon.png",
				"backgroundColor": "#060F2B"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.matrix122001.HabitTrackerApp",
			"googleServicesFile": "./google-services.json",
			"versionCode": 14,
			"permissions": [
				"android.permission.RECEIVE_BOOT_COMPLETED",
				"android.permission.SCHEDULE_EXACT_ALARM",
				"android.permission.USE_EXACT_ALARM",
				"android.permission.VIBRATE",
				"android.permission.POST_NOTIFICATIONS",
				"android.permission.READ_SMS",
				"android.permission.RECEIVE_SMS",
				"android.permission.REQUEST_INSTALL_PACKAGES"
			]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"react-native-android-widget",
				{
					"widgets": [
						{
							"name": "TodayHabits",
							"label": "Today's habits",
							"description": "Your habits for today - tick them off from the home screen",
							"minWidth": "250dp",
							"minHeight": "180dp",
							"targetCellWidth": 4,
							"targetCellHeight": 3,
							"resizeMode": "horizontal|vertical",
							"updatePeriodMillis": 1800000
						},
						{
							"name": "Finance",
							"label": "Money",
							"description": "This month's spending and income, and your recent transactions",
							"minWidth": "250dp",
							"minHeight": "180dp",
							"targetCellWidth": 4,
							"targetCellHeight": 3,
							"resizeMode": "horizontal|vertical",
							"updatePeriodMillis": 1800000
						}
					]
				}
			],
			[
				"expo-alternate-app-icons",
				[
					{ "name": "Light", "ios": "./assets/images/app-icons/light.png", "android": { "foregroundImage": "./assets/images/app-icons/light-foreground.png", "backgroundColor": "#F4F7FB" } },
					{ "name": "Black", "ios": "./assets/images/app-icons/black.png", "android": { "foregroundImage": "./assets/images/app-icons/black-foreground.png", "backgroundColor": "#000000" } },
					{ "name": "Ocean", "ios": "./assets/images/app-icons/ocean.png", "android": { "foregroundImage": "./assets/images/app-icons/ocean-foreground.png", "backgroundColor": "#0A84FF" } }
				]
			],
			[
				"expo-notifications",
				{
					"icon": "./assets/images/notification-icon.png",
					"color": "#1FD1A0",
					"defaultChannel": "default",
					"modes": "productionMode",
					"sounds": [
						"./assets/sounds/notifications/ls_alarm_classic.wav",
						"./assets/sounds/notifications/ls_alarm_digital.wav",
						"./assets/sounds/notifications/ls_alarm_morning.wav",
						"./assets/sounds/notifications/ls_alarm_pulse.wav",
						"./assets/sounds/notifications/ls_alarm_rising.wav",
						"./assets/sounds/notifications/ls_alarm_siren.wav",
						"./assets/sounds/notifications/ls_bell.wav",
						"./assets/sounds/notifications/ls_chime.wav",
						"./assets/sounds/notifications/ls_ding.wav",
						"./assets/sounds/notifications/ls_harp.wav",
						"./assets/sounds/notifications/ls_marimba.wav",
						"./assets/sounds/notifications/ls_pop.wav",
						"./assets/sounds/notifications/ls_water_pour.wav"
					]
				}
			],
			"expo-web-browser",
			"expo-secure-store",
			"./plugins/withSmsPermission",
			"./plugins/withNotificationListener",
			"./plugins/withReleaseSigning"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "14a97a0e-a9fd-4c69-ad41-e5227ec32f6c"
			}
		},
		"owner": "matrix122001",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/14a97a0e-a9fd-4c69-ad41-e5227ec32f6c",
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0,
			"requestHeaders": {
				"expo-channel-name": "production"
			}
		}
	}
}
